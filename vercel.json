{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/s/:slug", "destination": "/api/site?slug=:slug" },
    { "source": "/trello-bridge.html", "destination": "/trello-bridge.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/run-scheduled", "schedule": "0 13 * * *" }
  ]
}
